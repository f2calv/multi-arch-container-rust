# Remove the line below if you want to inherit .editorconfig settings from higher directories
root = true

#### Common to every file ####

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,json,json5}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Rust files
# Formatting is owned by rustfmt; these settings also cover files rustfmt does not touch.
[*.rs]
indent_size = 4
max_line_length = 100

[*.toml]
indent_size = 4
